# PostgreSQL
POSTGRES_USER=wonder
POSTGRES_PASSWORD=wonder_secret
POSTGRES_DB=wonder_fitness

# Copy to .env.local when running `npm run dev` against docker DB:
# DATABASE_URL="postgresql://wonder:wonder_secret@localhost:5432/wonder_fitness?schema=public"
DATABASE_URL="postgresql://wonder:wonder_secret@localhost:5432/wonder_fitness?schema=public"
AUTH_SECRET="wonder-fitness-demo-secret-change-me-32chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_MODE="true"

# IP LAN của máy chạy Docker — proxy HTTPS (cổng 3443) dùng để cấp chứng chỉ tự ký.
# scripts/docker-up.ps1 tự dò IP và truyền biến này, không cần điền tay.
LAN_IP=

# SMTP (Gmail) — gửi OTP thật cho liên kết email & quên mật khẩu
# Tạo App Password tại https://myaccount.google.com/apppasswords (bỏ khoảng trắng khi dán).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="wonderfitnessgymcenter@gmail.com"
SMTP_PASS="hikjtzcizucmqkmd"
MAIL_FROM="Wonder Fitness <wonderfitnessgymcenter@gmail.com>"
